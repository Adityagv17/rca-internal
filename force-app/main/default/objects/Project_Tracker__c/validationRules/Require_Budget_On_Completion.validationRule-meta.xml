<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Require_Budget_On_Completion</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, &apos;Completed&apos;), ISBLANK(Budget__c))</errorConditionFormula>
    <errorMessage>Budget is required when marking a project as Completed.</errorMessage>
</ValidationRule>
